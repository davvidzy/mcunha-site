---
import ProjectCard from './ProjectCard.astro';
import { getHomeProjetos } from '../lib/projetos';

// Ordem definida no painel (arrastando); vagas livres são completadas por prioridade
const projetos = await getHomeProjetos();
---

<section id="projetos" class="section-y relative isolate overflow-hidden bg-cream">
  <img src="/svg/deco-projetos.svg" alt="" aria-hidden="true" class="deco top-[66%] right-[-6%] hidden w-[clamp(160px,18.5vw,267px)] md:block" data-float="-90" />

  <div class="container-x flex flex-col gap-6 text-navy-900">
    <h2 class="section-title" data-reveal="split">Projetos</h2>
    <p class="section-sub" data-reveal data-delay="0.15">Cada chapa, um projeto único</p>
  </div>

  <ul
    class="mx-auto mt-[clamp(2.5rem,4.4vw,4rem)] flex max-w-[1440px] snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 py-6 [scrollbar-width:none] md:grid md:snap-none md:grid-cols-3 md:gap-6 md:overflow-visible md:px-6"
    data-reveal="stagger"
    data-projects-track
  >
    {
      projetos.map((p) => (
        <li class="w-[84vw] max-w-[420px] shrink-0 snap-start md:w-auto md:max-w-none">
          <ProjectCard projeto={p} />
        </li>
      ))
    }
  </ul>

  <!-- Indicador do carrossel (mobile) -->
  <div class="mt-2 flex justify-center gap-2 md:hidden" aria-hidden="true" data-projects-dots>
    {projetos.map((_, i) => <span class:list={['project-dot h-1.5 rounded-full', i === 0 && 'is-active']} />)}
  </div>

  <div class="mt-[clamp(2rem,4.4vw,4rem)] flex justify-center">
    <a href="/projetos/" class="link-underline text-base text-navy-950" data-reveal>VER TODOS</a>
  </div>
</section>

<style>
  .project-dot {
    width: 6px;
    background: var(--color-stone-400);
    opacity: 0.5;
    transition:
      width 0.5s var(--ease-out-expo),
      opacity 0.3s,
      background-color 0.3s;
  }
  .project-dot.is-active {
    width: 22px;
    opacity: 1;
    background: var(--color-navy-900);
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-projects-track]');
  const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-projects-dots] > span'));
  if (track && dots.length) {
    const cards = Array.from(track.children) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const i = cards.indexOf(e.target as HTMLElement);
            dots.forEach((d, j) => d.classList.toggle('is-active', i === j));
          }
        });
      },
      { root: track, threshold: 0.6 },
    );
    cards.forEach((c) => io.observe(c));
  }
</script>
