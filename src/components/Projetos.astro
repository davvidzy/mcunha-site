---
import { Picture } from 'astro:assets';
import salaJantar from '../assets/img/projeto-sala-jantar.webp';
import mesaCentro from '../assets/img/projeto-mesa-centro.webp';
import fachada from '../assets/img/projeto-fachada.webp';

// Títulos provisórios: ajustar com os nomes reais dos projetos
const projetos = [
  { img: salaJantar, title: 'Sala de jantar', tag: 'Travertino e quartzo', alt: 'Sala de jantar com parede em travertino e mesa em quartzo branco', href: '#' },
  { img: mesaCentro, title: 'Mesa de centro', tag: 'Mármore', alt: 'Mesa de centro redonda com tampo em mármore branco', href: '#' },
  { img: fachada, title: 'Fachada residencial', tag: 'Travertino', alt: 'Fachada residencial revestida em travertino com porta preta', href: '#' },
];
---

<section id="projetos" class="section-y relative isolate overflow-hidden bg-cream">
  <img src="/svg/deco-projetos.svg" alt="" aria-hidden="true" class="deco top-[66%] right-[-6%] hidden w-[clamp(160px,18.5vw,267px)] md:block" data-float="-90" />

  <div class="container-x flex flex-col gap-6 text-navy-900">
    <h2 class="section-title" data-reveal="split">Projetos</h2>
    <p class="section-sub" data-reveal data-delay="0.15">Cada chapa, um projeto único</p>
  </div>

  <ul
    class="mx-auto mt-[clamp(2.5rem,4.4vw,4rem)] flex max-w-[1440px] snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 py-6 [scrollbar-width:none] md:grid md:snap-none md:grid-cols-3 md:gap-6 md:overflow-visible md:px-6"
    data-reveal="stagger"
    data-projects-track
  >
    {
      projetos.map((p) => (
        <li class="w-[84vw] max-w-[420px] shrink-0 snap-start md:w-auto md:max-w-none">
          <a
            href={p.href}
            class="project-card group relative block aspect-[4/5] overflow-hidden rounded-[var(--radius-card)] shadow-[0_2px_25px_rgb(0_0_0/0.15)] sm:aspect-[448/320]"
          >
            <Picture
              src={p.img}
              alt={p.alt}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[420, 640, 900]}
              sizes="(min-width: 768px) 32vw, 84vw"
              class="project-img absolute inset-0 size-full object-cover"
            />
            <span class="project-shade absolute inset-0" aria-hidden="true" />
            <span class="project-dim absolute inset-0 bg-navy-950" aria-hidden="true" />
            <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-[clamp(1.125rem,2vw,1.75rem)] text-gold-50">
              <span class="project-text flex min-w-0 flex-col gap-1">
                <span class="text-xs font-semibold tracking-[0.14em] text-gold-100 uppercase">{p.tag}</span>
                <span class="font-serif text-[clamp(1.5rem,1rem+1.3vw,2.25rem)] leading-tight">{p.title}</span>
              </span>
              <!-- Mouse: botão completo aparece no hover · Toque: seta sempre visível -->
              <span class="project-btn btn btn-gold !px-5 !py-3 !text-base">
                Ver projeto
                <img src="/svg/arrow-dark.svg" alt="" width="14" height="13" class="w-[14px]" />
              </span>
              <span class="project-arrow grid size-11 shrink-0 place-items-center rounded-full bg-gold-300" aria-hidden="true">
                <img src="/svg/arrow-dark.svg" alt="" width="14" height="13" class="w-[14px]" />
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Indicador do carrossel (mobile) -->
  <div class="mt-2 flex justify-center gap-2 md:hidden" aria-hidden="true" data-projects-dots>
    {projetos.map((_, i) => <span class:list={['project-dot h-1.5 rounded-full', i === 0 && 'is-active']} />)}
  </div>

  <div class="mt-[clamp(2rem,4.4vw,4rem)] flex justify-center">
    <a href="#" class="link-underline text-base text-navy-950" data-reveal>VER TODOS</a>
  </div>
</section>

<style>
  /* Título e categoria sempre visíveis (mouse e toque). No hover: zoom, escurece e o botão "Ver projeto" aparece. */
  .project-img :global(img),
  .project-img {
    transition: transform 1.1s var(--ease-out-expo);
  }
  .project-shade {
    background: linear-gradient(to top, rgb(8 17 31 / 0.8), rgb(8 17 31 / 0.25) 45%, transparent 70%);
  }
  .project-dim {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out-expo);
  }
  .project-text {
    transition: transform 0.7s var(--ease-out-expo);
  }
  .project-btn {
    display: none;
  }

  @media (hover: hover) and (min-width: 768px) {
    .project-arrow {
      display: none;
    }
    .project-btn {
      display: inline-flex;
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.5s var(--ease-out-expo),
        transform 0.7s var(--ease-out-expo);
    }
    .project-card:hover .project-img,
    .project-card:focus-visible .project-img {
      transform: scale(1.07);
    }
    .project-card:hover .project-dim,
    .project-card:focus-visible .project-dim {
      opacity: 0.3;
    }
    .project-card:hover .project-text,
    .project-card:focus-visible .project-text {
      transform: translateY(-4px);
    }
    .project-card:hover .project-btn,
    .project-card:focus-visible .project-btn {
      opacity: 1;
      transform: none;
    }
  }

  .project-dot {
    width: 6px;
    background: var(--color-stone-400);
    opacity: 0.5;
    transition:
      width 0.5s var(--ease-out-expo),
      opacity 0.3s,
      background-color 0.3s;
  }
  .project-dot.is-active {
    width: 22px;
    opacity: 1;
    background: var(--color-navy-900);
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-projects-track]');
  const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-projects-dots] > span'));
  if (track && dots.length) {
    const cards = Array.from(track.children) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const i = cards.indexOf(e.target as HTMLElement);
            dots.forEach((d, j) => d.classList.toggle('is-active', i === j));
          }
        });
      },
      { root: track, threshold: 0.6 },
    );
    cards.forEach((c) => io.observe(c));
  }
</script>
