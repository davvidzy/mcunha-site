---
// Logo composto pelas 5 peças vetoriais exportadas do Figma (nó 1:2150).
// Posições absolutas idênticas ao frame do Figma (caixa útil 136.36 × 66), escaladas por --logo-scale.
// Cada peça carrega a sombra do Figma, por isso o <img> transborda a caixa (inset negativo).
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

const W = 136.355;
const H = 66;
const parts = [
  { src: '/svg/logo-m.svg', x: 0, y: 0, w: 57.223, h: 66, inset: '-6.52% -11.01% -12.58% -11.01%' },
  { src: '/svg/logo-u.svg', x: 59.223, y: 21.247, w: 17.783, h: 23.507, inset: '-17.2% -35.43% -35.31% -35.43%' },
  // Vetor girado 180° no Figma: x/y são do canto de origem, então a caixa visível começa em (x - w, y - h)
  { src: '/svg/logo-n.svg', x: 79.006, y: 21.376, w: 17.783, h: 23.249, inset: '-18.5% -35.43% -35.7% -35.43%', rotate: true },
  { src: '/svg/logo-h.svg', x: 98.789, y: 18.664, w: 17.783, h: 28.673, inset: '-15% -35.43% -28.95% -35.43%' },
  { src: '/svg/logo-a.svg', x: 118.572, y: 24.217, w: 17.783, h: 17.565, inset: '-24.48% -35.43% -47.25% -35.43%' },
];
const pct = (v: number, t: number) => `${((v / t) * 100).toFixed(3)}%`;
---

<span
  class:list={['logo relative inline-block align-middle', cls]}
  style={`width:calc(${W}px * var(--logo-scale,1));height:calc(${H}px * var(--logo-scale,1))`}
  role="img"
  aria-label="MCunha Marmoraria"
>
  {
    parts.map((p) => (
      <span
        class="absolute"
        style={`left:${pct(p.x, W)};top:${pct(p.y, H)};width:${pct(p.w, W)};height:${pct(p.h, H)};${p.rotate ? 'transform:rotate(180deg)' : ''}`}
      >
        <span class="absolute block" style={`inset:${p.inset}`}>
          <img src={p.src} alt="" class="block size-full max-w-none" width={p.w} height={p.h} />
        </span>
      </span>
    ))
  }
</span>
