---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MCunha Marmoraria | Pedra natural sob medida no Lago Sul, Brasília',
  description = 'Mármores, granitos, quartzitos e ônix do projeto à instalação, com produção própria e showroom no Lago Sul, Brasília/DF.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5f1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300;0,400;0,500;0,600;0,900;1,500&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Nunito:wght@400&display=swap"
    />

    <script is:inline>
      // Ativa estados iniciais de animação só se houver JS e o usuário não pedir menos movimento
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
      }
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'HomeAndConstructionBusiness',
        name: 'MCunha Marmoraria',
        telephone: '+55 61 98119-3538',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'QI 21, Bloco E, Loja 54',
          addressLocality: 'Lago Sul, Brasília',
          addressRegion: 'DF',
          postalCode: '71655-590',
          addressCountry: 'BR',
        },
        openingHours: ['Mo-Fr 08:00-18:00', 'Sa 08:00-12:00'],
      })}
    />
  </head>
  <body class="bg-cream text-navy-900">
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
