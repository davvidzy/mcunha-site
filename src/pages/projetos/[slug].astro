---
import type { CollectionEntry } from 'astro:content';
import { getProjetos } from '../../lib/projetos';
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { whatsappLink } from '../../lib/contact';

export async function getStaticPaths() {
  const todos = await getProjetos();
  return todos.map((projeto, i) => ({
    params: { slug: projeto.id },
    props: {
      projeto,
      // Até 2 sugestões: os próximos na ordem (circular)
      outros: todos.length > 1 ? [1, 2].map((k) => todos[(i + k) % todos.length]).filter((p, j, arr) => p.id !== projeto.id && arr.indexOf(p) === j) : [],
    },
  }));
}

interface Props {
  projeto: CollectionEntry<'projetos'>;
  outros: CollectionEntry<'projetos'>[];
}
const { projeto, outros } = Astro.props;
const p = projeto.data;
const paragrafos = p.descricao
  .split(/\n\s*\n/)
  .map((t) => t.trim())
  .filter(Boolean);
const ficha = [
  { k: 'Materiais', v: p.materiais },
  { k: 'Ambiente', v: p.ambiente },
  { k: 'Local', v: p.local },
].filter((f) => f.v);
const cta = whatsappLink(`Olá! Vi o projeto "${p.titulo}" no site e gostaria de um orçamento para algo parecido.`);
// Galeria completa (capa + fotos) para o visualizador
const fotos = [{ imagem: p.capa, alt: p.capaAlt }, ...p.galeria.map((g) => ({ imagem: g.imagem, alt: g.alt || p.titulo }))];
---

<Layout title={`${p.titulo} | Projetos MCunha Marmoraria`} description={`${p.titulo}: projeto em ${p.materiais.toLowerCase()} executado pela MCunha Marmoraria.`}>
  <Header />
  <main id="conteudo" tabindex="-1" class="bg-cream outline-none pt-[64px] lg:pt-[76px]">
    <article>
      <header class="container-x pt-[clamp(2rem,5vw,4rem)]">
        <nav aria-label="Você está em" class="mb-8 text-sm text-stone-600">
          <a href="/" class="hover:underline">Início</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <a href="/projetos/" class="hover:underline">Projetos</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <span aria-current="page" class="text-navy-900">{p.titulo}</span>
        </nav>
        <p class="mb-4 text-xs font-semibold tracking-[0.16em] text-gold-700 uppercase" data-reveal>
          {[p.materiais, p.ambiente].filter(Boolean).join(' · ')}
        </p>
        <h1 class="max-w-[18ch] font-serif text-[length:var(--text-display)] leading-[1.02] text-navy-900" data-reveal="split">
          {p.titulo}
        </h1>
      </header>

      <!-- Capa -->
      <div class="mx-auto mt-[clamp(2rem,4vw,3.5rem)] max-w-[1440px] px-[clamp(0.75rem,1.6vw,1.5rem)]">
        <button
          type="button"
          class="group block w-full cursor-zoom-in overflow-hidden rounded-[var(--radius-card)]"
          data-open-photo="0"
          aria-label="Ampliar foto de capa"
          data-reveal="clip"
        >
          <Picture
            src={p.capa}
            alt={p.capaAlt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[640, 960, 1400, 1920]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] w-full object-cover transition-transform duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-[1.02] sm:aspect-[16/9]"
          />
        </button>
      </div>

      <!-- Texto + ficha -->
      <div class="container-x grid gap-12 py-[clamp(3.5rem,7vw,6rem)] lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:gap-20">
        <div class="flex flex-col gap-5 text-[length:var(--text-body)] leading-relaxed text-navy-900" data-reveal>
          {
            paragrafos.length > 0 ? (
              paragrafos.map((t) => <p class="max-w-[62ch]">{t}</p>)
            ) : (
              <p class="max-w-[62ch]">
                Projeto em {p.materiais.toLowerCase()}, com medição, produção e instalação feitas pela equipe MCunha.
              </p>
            )
          }
        </div>

        <aside class="flex flex-col gap-8 lg:sticky lg:top-28 lg:self-start" data-reveal data-delay="0.1">
          <dl class="divide-y divide-stone-400/50 border-y border-stone-400/50">
            {
              ficha.map((f) => (
                <div class="flex items-baseline justify-between gap-6 py-4">
                  <dt class="text-xs font-semibold tracking-[0.14em] text-stone-600 uppercase">{f.k}</dt>
                  <dd class="text-right font-serif text-[clamp(1.125rem,1rem+0.3vw,1.375rem)] text-navy-900">{f.v}</dd>
                </div>
              ))
            }
          </dl>
          <div class="flex flex-col gap-3">
            <a href={cta} target="_blank" rel="noopener" class="btn btn-gold w-full max-sm:!text-[15px]">
              Quero um projeto assim
              <img src="/svg/arrow-dark.svg" alt="" width="14" height="13" class="w-[14px]" />
            </a>
            <p class="text-center text-sm text-stone-600">Você será direcionado ao WhatsApp com a mensagem pronta</p>
          </div>
        </aside>
      </div>

      <!-- Galeria -->
      {
        p.galeria.length > 0 && (
          <section aria-label="Galeria de fotos" class="mx-auto max-w-[1440px] px-[clamp(0.75rem,1.6vw,1.5rem)] pb-[clamp(4rem,8vw,7rem)]">
            <ul class="gallery grid grid-cols-2 gap-3 md:gap-5" data-reveal="stagger">
              {p.galeria.map((g, i) => (
                <li class:list={['gallery-item', (i % 3 === 0) && 'col-span-2']}>
                  <button
                    type="button"
                    class="group block size-full cursor-zoom-in overflow-hidden rounded-[var(--radius-card)]"
                    data-open-photo={i + 1}
                    aria-label={`Ampliar foto ${i + 1}`}
                  >
                    <Picture
                      src={g.imagem}
                      alt={g.alt || p.titulo}
                      formats={['avif', 'webp']}
                      fallbackFormat="jpg"
                      widths={[480, 800, 1200, 1600]}
                      sizes={i % 3 === 0 ? '100vw' : '50vw'}
                      class:list={[
                        'w-full object-cover transition-transform duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-[1.03]',
                        i % 3 === 0 ? 'aspect-[16/9]' : 'aspect-[4/5]',
                      ]}
                    />
                  </button>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>

    <!-- Outros projetos -->
    {
      outros.length > 0 && (
        <section class="border-t border-stone-400/50 py-[clamp(4rem,8vw,7rem)]">
          <div class="container-x flex flex-col gap-10">
            <div class="flex items-end justify-between gap-6">
              <h2 class="section-title text-navy-900" data-reveal="split">Outros projetos</h2>
              <a href="/projetos/" class="link-underline shrink-0 text-base text-navy-950" data-reveal>VER TODOS</a>
            </div>
            <ul class="grid gap-5 sm:grid-cols-2 md:gap-6" data-reveal="stagger">
              {outros.map((o) => (
                <li>
                  <ProjectCard projeto={o} sizes="(min-width: 640px) 48vw, 92vw" />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </main>
  <Footer />

  <!-- Visualizador de fotos -->
  <dialog id="lightbox" class="lightbox m-0 size-full max-h-none max-w-none bg-transparent p-0" aria-label={`Fotos: ${p.titulo}`}>
    <div class="relative grid size-full place-items-center bg-navy-950/95 p-4 sm:p-10">
      {
        fotos.map((f, i) => (
          <figure class="lightbox-slide absolute inset-4 grid place-items-center sm:inset-16" data-slide={i} hidden={i !== 0}>
            <Picture
              src={f.imagem}
              alt={f.alt}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[800, 1400, 2000]}
              sizes="100vw"
              loading="lazy"
              class="max-h-full w-auto max-w-full rounded-xl object-contain"
            />
          </figure>
        ))
      }
      <p class="absolute bottom-5 left-1/2 -translate-x-1/2 text-sm tabular-nums text-gold-50/80" data-lb-count>1 / {fotos.length}</p>
      <button type="button" class="lb-btn top-4 right-4" data-lb-close aria-label="Fechar">
        <img src="/svg/close.svg" alt="" width="24" height="24" class="size-6" />
      </button>
      {
        fotos.length > 1 && (
          <>
            <button type="button" class="lb-btn top-1/2 left-3 -translate-y-1/2 sm:left-6" data-lb-prev aria-label="Foto anterior">
              <img src="/svg/chev-left.svg" alt="" width="24" height="24" class="size-6" />
            </button>
            <button type="button" class="lb-btn top-1/2 right-3 -translate-y-1/2 sm:right-6" data-lb-next aria-label="Próxima foto">
              <img src="/svg/chev-right.svg" alt="" width="24" height="24" class="size-6" />
            </button>
          </>
        )
      }
    </div>
  </dialog>
</Layout>

<style>
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox[open] {
    animation: lb-in 0.35s var(--ease-out-expo);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.15);
    transition: background-color 0.3s;
  }
  .lb-btn:hover {
    background: rgb(255 255 255 / 0.18);
  }
</style>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const slides = Array.from(dlg.querySelectorAll<HTMLElement>('[data-slide]'));
    const count = dlg.querySelector('[data-lb-count]')!;
    let cur = 0;
    const show = (i: number) => {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, j) => (s.hidden = j !== cur));
      count.textContent = `${cur + 1} / ${slides.length}`;
    };
    const lenis = () => (window as any).__lenis;

    document.querySelectorAll<HTMLElement>('[data-open-photo]').forEach((b) =>
      b.addEventListener('click', () => {
        show(Number(b.dataset.openPhoto));
        dlg.showModal();
        lenis()?.stop();
      }),
    );
    dlg.addEventListener('close', () => lenis()?.start());
    dlg.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(cur - 1));
    dlg.querySelector('[data-lb-next]')?.addEventListener('click', () => show(cur + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    });
    // Clique fora da foto fecha
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('button') || t.tagName === 'IMG') return;
      dlg.close();
    });
    // Arrastar no celular
    let x0 = 0;
    dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
    });
  }
</script>
